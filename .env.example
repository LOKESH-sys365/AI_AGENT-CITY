# Free local AI through Ollama (no API key needed)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
# Agents can only touch files inside this folder
CITY_ROOT=~/AgentCity

# Auth.js Google sign-in
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public HTTPS origin for A2A in production (example: https://agents.example.com)
A2A_PUBLIC_URL=

# GitHub issue, pull request, and comment tools (fine-grained token; no code permissions)
GITHUB_TOKEN=
